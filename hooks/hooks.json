{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh\" route-agent",
            "timeout": 15,
            "statusMessage": "Jev: choosing subagent model"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh\" gate-bash",
            "timeout": 15,
            "statusMessage": "Jev: screening command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh\" triage-prompt",
            "timeout": 15,
            "statusMessage": "Jev: triaging request"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh\" verify-stop",
            "timeout": 15,
            "statusMessage": "Jev: checking claims against what ran"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh\" verify-stop",
            "timeout": 15,
            "statusMessage": "Jev: checking the subagent's claims against what ran"
          }
        ]
      }
    ]
  }
}
